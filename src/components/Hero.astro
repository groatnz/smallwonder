---
---

<section id="home" class="hero">
  <div class="hero-background">
    <img 
      src="/images/hero.jpeg" 
      alt="Practitioner or parent with baby, relaxed and fully clothed, clearly non-clinical"
      class="hero-bg-image"
      loading="eager"
    />
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-text">
      <p class="hero-headline">
        Learn how to massage your own baby in a baby-led way.
      </p>
      <p class="hero-subheading">
      Certified infant massage instructor, running small group classes on Waiheke.
      </p>      
    
      <div class="hero-ctas">
        <a href="#contact" class="button button-primary">Message Millie</a>
        <a href="#classes" class="button button-secondary">View class dates</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Parallax effect for hero background
  function initParallax() {
    const hero = document.querySelector('.hero');
    const heroBg = document.querySelector('.hero-bg-image');
    
    if (!hero || !heroBg) return;
    
    function handleScroll() {
      const scrolled = window.pageYOffset;
      const heroHeight = hero.offsetHeight;
      const scrollProgress = scrolled / heroHeight;
      
      // Parallax effect: image moves slower than scroll
      heroBg.style.transform = `translateY(${scrolled * 0.5}px)`;
      heroBg.style.opacity = Math.max(0.3, 1 - scrollProgress * 0.5);
    }
    
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initial call
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParallax);
  } else {
    initParallax();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
    transition: opacity 0.3s ease;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(45, 52, 54, 0.4) 0%,
      rgba(45, 52, 54, 0.5) 50%,
      rgba(45, 52, 54, 0.6) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    padding: var(--spacing-3xl) var(--spacing-md);
    margin: 0 auto;
  }

  .hero-text {
    text-align: center;
    color: white;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: var(--spacing-xl);
    line-height: 1.1;
    font-weight: 300;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    letter-spacing: -0.02em;
  }

  .hero-subheading {
    font-size: clamp(1.25rem, 3.5vw, 2rem);
    margin-bottom: var(--spacing-2xl);
    opacity: 0.95;
    max-width: 70ch;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.4;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.2);
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
    margin-top: var(--spacing-2xl);
  }

  .button-primary {
    background: color-mix(in oklab, white 85%, var(--sw-sage));
    font-weight: 400;
    color: var(--sw-ink);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .button-primary:hover {
    background: color-mix(in oklab, white 90%, var(--sw-sage));
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
  }

  .button-secondary {
    background: color-mix(in oklab, white 85%, var(--sw-rose));
    color: var(--sw-ink);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .button-secondary:hover {
    background: color-mix(in oklab, white 90%, var(--sw-rose));
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .hero-ctas {
      flex-direction: row;
      justify-content: center;
      gap: var(--spacing-lg);
    }

    .hero-headline {
      margin-bottom: var(--spacing-2xl);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 100vh;
    }
  }
</style>


